[
  {
    "name": "multiple wrong PIN attempts then correct PIN creates note",
    "steps": [
      { "send": { "text": "/setpin" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "mypin" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "mypin" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/add" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Test" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Content" }, "expect": [{ "method": "sendMessage" }] },
      {
        "send": { "text": "wrong1" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Wrong PIN. Try again." } }]
      },
      {
        "send": { "text": "wrong2" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Wrong PIN. Try again." } }]
      },
      {
        "send": { "text": "mypin" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "✅ Note saved!" } }]
      }
    ]
  }
]