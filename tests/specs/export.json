[
  {
    "name": "export without PIN tells user to set PIN first",
    "steps": [
      {
        "send": { "callback": "export:start" },
        "expect": [
          {
            "method": "editMessageText",
            "payload": { "text": "You need to set a PIN first. Tap 🔑 Set PIN in the menu." }
          }
        ]
      }
    ]
  },
  {
    "name": "export without notes shows empty state",
    "steps": [
      { "send": { "text": "/setpin" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "mypin" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "mypin" }, "expect": [{ "method": "sendMessage" }] },
      {
        "send": { "callback": "export:start" },
        "expect": [
          {
            "method": "editMessageText",
            "payload": { "text": "No notes to export — tap 📝 Add note to create one." }
          }
        ]
      }
    ]
  },
  {
    "name": "export with notes sends document file",
    "steps": [
      { "send": { "text": "/setpin" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "mypin" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "mypin" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "/add" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Shopping list" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Milk, eggs, bread" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "mypin" }, "expect": [{ "method": "sendMessage" }] },
      {
        "send": { "callback": "export:start" },
        "expect": [
          { "method": "editMessageText", "payload": { "text": "Enter your PIN to export all notes. Your PIN message will be removed after submission." } }
        ]
      },
      {
        "send": { "text": "mypin" },
        "expect": [
          { "method": "sendDocument" }
        ]
      }
    ]
  }
]